{
  "name": "codex-switch",
  "private": true,
  "version": "2.1.7",
  "license": "Apache-2.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "packages/i18n"
  ],
  "scripts": {
    "dev": "npm run dev -w @codex-switch/desktop",
    "dev:desktop": "npm run dev -w @codex-switch/desktop",
    "dev:app": "npm run dev:app -w @codex-switch/desktop",
    "build": "npm run build:desktop",
    "build:desktop": "npm run build -w @codex-switch/desktop",
    "build:app": "npm run build:app -w @codex-switch/desktop",
    "check": "npm run check -w @codex-switch/desktop && npm run check:i18n",
    "preview": "npm run preview -w @codex-switch/desktop",
    "tauri": "npm run tauri -w @codex-switch/desktop",
    "prepare": "husky",
    "check:i18n": "npm run check -w @interlude/i18n",
    "generate:i18n": "npm run generate -w @interlude/i18n"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "esbuild": "0.25.12",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "nx": "^23.0.1"
  }
}
